
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>WORLDTV PRO MAX IPTV SAAS</title>

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

<style>

/* =========================
BASE
========================= */

*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif;}
body{background:#050816;color:#fff;overflow:hidden;display:flex;}

/* =========================
SIDEBAR
========================= */

.sidebar{
width:300px;
height:100vh;
background:#0d1324;
padding:15px;
overflow-y:auto;
border-right:1px solid #1d2b4f;
}

.logo{font-size:24px;font-weight:900;color:#00d4ff;}
.sub{font-size:12px;color:#8ea2d9;margin-bottom:15px;}

.menu-title{color:#00d4ff;margin:15px 0 10px;font-size:12px}

.nav-btn{
width:100%;
padding:12px;
margin:6px 0;
background:#121c33;
border:none;
border-radius:10px;
color:#fff;
cursor:pointer;
transition:.3s;
}
.nav-btn:hover{background:#1e2f57;transform:translateX(4px);}

/* =========================
MAIN
========================= */

.main{
flex:1;
padding:15px;
overflow:hidden;
display:flex;
flex-direction:column;
}

/* TOPBAR */

.topbar{
display:flex;
justify-content:space-between;
flex-wrap:wrap;
gap:10px;
margin-bottom:10px;
}

.search-box input{
padding:12px;
border-radius:10px;
border:none;
background:#101a31;
color:#fff;
width:260px;
}

.live{
background:red;
padding:8px 14px;
border-radius:20px;
font-weight:bold;
}

/* HERO */

.hero{
background:linear-gradient(135deg,#07132f,#0f1d45);
padding:15px;
border-radius:12px;
margin-bottom:10px;
border:1px solid #1e3f78;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-top:10px;
}

.stat{
background:#101d39;
padding:10px;
border-radius:10px;
text-align:center;
}

/* PLAYER */

.player{
background:black;
height:320px;
border-radius:10px;
overflow:hidden;
margin-bottom:10px;
}

video{
width:100%;
height:100%;
}

/* CONTROLS */

.controls{
display:flex;
flex-wrap:wrap;
gap:8px;
margin-bottom:10px;
}

.controls button{
padding:10px;
border:none;
border-radius:8px;
background:#152445;
color:#fff;
cursor:pointer;
}
.controls button:hover{background:#00d4ff;color:#000;}

/* CHANNEL GRID */

.channels{
flex:1;
overflow:auto;
display:grid;
grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
gap:10px;
padding-bottom:60px;
}

.card{
background:#111a31;
padding:12px;
border-radius:12px;
cursor:pointer;
border:1px solid #1f355d;
transition:.3s;
}
.card:hover{transform:scale(1.03);border-color:#00d4ff;}

.badge{
background:red;
padding:3px 8px;
border-radius:10px;
font-size:10px;
float:right;
}

/* =========================
BOTTOM TICKER
========================= */

.bottom-ticker{
position:fixed;
bottom:0;
left:0;
width:100%;
height:45px;
background:#0b1220;
border-top:1px solid #1f2a44;
overflow:hidden;
display:flex;
align-items:center;
z-index:9999;
}

.ticker-track{
display:flex;
gap:40px;
white-space:nowrap;
animation:scroll 18s linear infinite;
padding-left:100%;
}

.ticker-item{
color:#00d4ff;
font-weight:600;
font-size:14px;
}

@keyframes scroll{
0%{transform:translateX(0);}
100%{transform:translateX(-100%);}
}

/* ========================= */

@media(max-width:900px){
body{flex-direction:column;}
.sidebar{width:100%;height:auto;}
}

</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

<div class="logo">📺 BTECH IPTV SAAS</div>
<div class="sub">Full IPTV Cloud System</div>

<div class="menu-title">🌍 Countries</div>

<button class="nav-btn" onclick="load('ng')">🇳🇬 Nigeria</button>
<button class="nav-btn" onclick="load('us')">🇺🇸 USA</button>
<button class="nav-btn" onclick="load('uk')">🇬🇧 UK</button>
<button class="nav-btn" onclick="load('in')">🇮🇳 India</button>
<button class="nav-btn" onclick="load('fr')">🇫🇷 France</button>

<div class="menu-title">⚙ Tools</div>

<button class="nav-btn" onclick="next()">⏭ Next</button>
<button class="nav-btn" onclick="prev()">⏮ Prev</button>
<button class="nav-btn" onclick="toggleMute()">🔊 Mute</button>
<button class="nav-btn" onclick="toggleFullscreen()">⛶ Fullscreen</button>

</div>

<!-- MAIN -->
<div class="main">

<div class="topbar">

<div class="search-box">
<input oninput="search(this.value)" placeholder="Search IPTV channels...">
</div>

<div class="live">🔴 LIVE</div>

</div>

<div class="hero">
<h2>WORLDTV SAAS IPTV SYSTEM</h2>

<div class="stats">
<div class="stat">📺 <div id="total">0</div></div>
<div class="stat">🌍 Live <div id="live">0</div></div>
<div class="stat">⚫ Dead <div id="dead">0</div></div>
<div class="stat">⭐ Fav <div id="fav">0</div></div>
</div>
</div>

<div class="player">
<video id="video" controls autoplay muted></video>
</div>

<div class="controls">
<button onclick="next()">▶ Next</button>
<button onclick="prev()">◀ Prev</button>
<button onclick="toggleMute()">🔊 Mute</button>
<button onclick="toggleFullscreen()">⛶ Fullscreen</button>
<button onclick="loadGlobal()">🌍 Global</button>
</div>

<div class="channels" id="grid"></div>

</div>

<!-- 🔥 BOTTOM SCROLLING CHANNEL BAR -->
<div class="bottom-ticker">
  <div class="ticker-track" id="ticker"></div>
</div>

<script>

let all=[],filtered=[],i=0;
let video=document.getElementById("video");
let hls;

/* LOAD COUNTRY */
async function load(code){
await loadM3U(`https://iptv-org.github.io/iptv/countries/${code}.m3u`);
}

/* GLOBAL */
async function loadGlobal(){
await loadM3U("https://iptv-org.github.io/iptv/index.country.m3u");
}

/* M3U */
async function loadM3U(url){

const res=await fetch(url);
const text=await res.text();

all=[];
filtered=[];
i=0;

const lines=text.split("\n");

for(let x=0;x<lines.length;x++){
if(lines[x].startsWith("#EXTINF")){
let name=lines[x].split(",").pop();
let url=lines[x+1];

if(url && url.startsWith("http")){
all.push({name,url});
}
}
}

filtered=[...all];

render();
stats();
updateTicker();

}

/* RENDER */
function render(){

let grid=document.getElementById("grid");
grid.innerHTML="";

filtered.forEach((c,idx)=>{

let div=document.createElement("div");
div.className="card";
div.innerHTML=`<div class="badge">LIVE</div>${c.name}`;

div.onclick=()=>play(idx);

grid.appendChild(div);
});

updateTicker();
}

/* PLAY */
function play(idx){

i=idx;

let c=filtered[i];

if(hls) hls.destroy();

if(Hls.isSupported()){
hls=new Hls();
hls.loadSource(c.url);
hls.attachMedia(video);
hls.on(Hls.Events.MANIFEST_PARSED,()=>video.play());
}else{
video.src=c.url;
video.play();
}

}

/* SEARCH */
function search(q){
filtered=all.filter(c=>c.name.toLowerCase().includes(q.toLowerCase()));
render();
}

/* NEXT PREV */
function next(){
i=(i+1)%filtered.length;
play(i);
}

function prev(){
i=(i-1+filtered.length)%filtered.length;
play(i);
}

/* UI */
function toggleMute(){video.muted=!video.muted;}

function toggleFullscreen(){video.requestFullscreen();}

/* STATS */
function stats(){
document.getElementById("total").innerText=all.length;
document.getElementById("live").innerText=all.length;
document.getElementById("dead").innerText=0;
document.getElementById("fav").innerText=0;
}

/* 🔥 TICKER */
function updateTicker(){
let t=document.getElementById("ticker");
t.innerHTML="";

filtered.slice(0,60).forEach(c=>{
let span=document.createElement("div");
span.className="ticker-item";
span.innerText="📺 "+c.name;
t.appendChild(span);
});
}

/* AUTO LOAD */
loadGlobal();

</script>

</body>
</html>
