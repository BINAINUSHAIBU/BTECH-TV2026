function paymentVerified(packageName){

    // Save Premium Status
    localStorage.setItem("premium", "true");
    localStorage.setItem("package", packageName);

    // Display Selected Package
    document.getElementById("successPackage").innerHTML = packageName;

    // Show Success Screen
    document.getElementById("paymentGateway").style.display = "none";
    document.getElementById("paymentSuccess").style.display = "flex";

}

// Continue to IPTV Player
function activatePremium(){

    window.location.href = "index.html";

}
