// Show Redirect Screen
function showRedirectScreen(){

    document.getElementById("subscriptionActivated").style.display = "none";
    document.getElementById("redirectScreen").style.display = "flex";

    let seconds = 5;

    document.getElementById("redirectTimer").innerHTML = seconds;

    const timer = setInterval(function(){

        seconds--;

        document.getElementById("redirectTimer").innerHTML = seconds;

        if(seconds <= 0){

            clearInterval(timer);

            enterPlayer();

        }

    },1000);

}

// Enter IPTV Player
function enterPlayer(){

    window.location.href = "index.html";

}
